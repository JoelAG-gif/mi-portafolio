---
interface Project {
  name: string;
  description: string;
  tech: string[];
  image: string;
  repoLink?: string;
  demoLink?: string;
  webLink?: string;
  isPrivate?: boolean;
  orientation?: 'horizontal' | 'vertical'; // detección manual si se necesita
}

const projects: Project[] = [
  {
    name: 'TENDŌ – Sistema de Gestión para Bodegas y Pequeños Negocios',
    description: 'Aplicación móvil completa para gestión de inventario y ventas diseñada específicamente para bodegas y pequeños comercios. Control de stock con alertas automáticas, gestión de cuentas por cobrar, sistema de promociones temporales, reportes HTML exportables, tracking histórico de precios y arquitectura SQLite optimizada para operación offline completa.',
    tech: ['React Native', 'Expo', 'SQLite', 'Supabase', 'REST API', 'WhatsApp Business'],
    image: 'assets/tendo.png',
    webLink: 'https://tendokoreapp.vercel.app/',
    isPrivate: false,
    orientation: 'vertical',
  },
  {
    name: 'SÜRI KŌRE – App Educativa de Matemáticas',
    description: 'Aplicación educativa que gamifica el aprendizaje de matemáticas desde nivel Inicial hasta Pre-universitario. Sistema de vidas, combos, cronómetro y 35+ operaciones matemáticas. Soporta 26 países con adaptación automática de grados escolares.',
    tech: ['React Native', 'Expo', 'SQLite', 'Animations', 'Gamification'],
    image: 'assets/surikore.png',
    webLink: 'https://surikoreapp.vercel.app/',
    isPrivate: false,
    orientation: 'vertical',
  },
  {
    name: 'Dashboard de Análisis de Ventas (Retail)',
    description: 'Tablero interactivo para el análisis de rendimiento comercial y cumplimiento presupuestario. Identifica KPIs clave, compara tiendas y detecta productos críticos mediante un modelo de datos robusto y cálculos DAX avanzados.',
    tech: ['Power BI', 'DAX', 'Power Query', 'Data Modeling'],
    image: 'assets/ventas x tienda.png',
    repoLink: 'https://github.com/JoelAG-gif/Analisis-Ventas-PowerBI',
    demoLink: 'https://drive.google.com/file/d/1f0ywkD6xU-9I4xeJ8Nc7twv-Icixaxb0/view?usp=sharing',
    orientation: 'horizontal',
  },
  {
    name: 'Cyberpunk Features UI',
    description: 'Componente de interfaz moderna con estética Cyberpunk. Incluye animaciones CSS avanzadas (scan-lines, efectos neon), diseño Grid responsivo y tipografías futuristas. Demuestra dominio en estilización y UX visual.',
    tech: ['Angular', 'CSS3 Avanzado', 'Keyframe Animations', 'Responsive Design'],
    image: 'assets/Cyberpunk.png',
    repoLink: 'https://github.com/JoelAG-gif/cyberpunk-ui.git',
    demoLink: 'https://drive.google.com/file/d/1pMhSbItB_APaHT4vBXWfTzSk-i9fGa3V/view?usp=sharing',
    webLink: 'https://cyberpunk-ui-six.vercel.app/',
    orientation: 'horizontal',
  },
  {
    name: 'App Móvil – Extintores Romero',
    description: 'Sistema integral con 3 roles (Admin, Técnico, Cliente). Permite la compra de extintores, gestión de inventario, solicitud y seguimiento de mantenimiento con flujo de estados y alertas automáticas de vencimiento.',
    tech: ['Android (Java)', 'PHP', 'MySQL', 'Volley', 'Material Design'],
    image: 'assets/appmovil.png',
    repoLink: 'https://github.com/JoelAG-gif/App-Extintores-Romero',
    demoLink: 'https://drive.google.com/file/d/1xybv6MSLWf7iS80w5ca8MGPkGPYVXFwW/view?usp=sharing',
    orientation: 'vertical',
  },
  {
    name: 'AESI – Diseño UI/UX E-commerce',
    description: 'Sistema de diseño completo para una plataforma dual: Tienda online para clientes y Panel Administrativo (CMS) para gestión de inventario. Enfocado en usabilidad, flujos de compra claros y una interfaz administrativa eficiente.',
    tech: ['Figma', 'UI/UX Design', 'Prototyping', 'Wireframing'],
    image: 'assets/darshboard del administrador.png',
    repoLink: 'https://github.com/JoelAG-gif/UI-Design.git',
    demoLink: 'https://www.figma.com/design/0BNJuNviTBVZyqapx9e3h9/AESI-Plataforma-de-Ecommerce?node-id=0-1',
    orientation: 'horizontal',
  },
  {
    name: 'AESI – Bolsa de Empleo Inclusiva',
    description: 'Plataforma de reclutamiento diseñada con enfoque en la inclusión laboral. Interfaz accesible que conecta talento diverso con empresas, facilitando procesos de selección equitativos. Incluye flujos completos para Candidatos y Reclutadores.',
    tech: ['Figma', 'UI/UX', 'Prototyping', 'User Flows'],
    image: 'assets/inicio.png',
    repoLink: 'https://github.com/JoelAG-gif/Bolsa-Empleo',
    demoLink: 'https://www.figma.com/design/v8Bj39tsTIkHu0J3lDEGeA/',
    orientation: 'horizontal',
  },
];
---

<section class="projects-section">
  <div class="section-header reveal">
    <div class="section-label">// proyectos</div>
    <h2 class="section-title">Proyectos <span class="highlight">Destacados</span></h2>
    <p class="section-sub">Una selección de mis trabajos recientes en desarrollo y análisis de datos.</p>
  </div>

  <div class="projects-list">
    {projects.map((p, i) => {
      const isVertical = p.orientation === 'vertical';
      const isReverse  = i % 2 === 1;
      return (
        <div
          class={`project-card reveal ${isReverse ? 'reverse' : ''} ${isVertical ? 'layout-vertical' : 'layout-horizontal'}`}
          style={`transition-delay:${i * 0.08}s`}
        >
          {/* Columna imagen */}
          <div class={`project-image-col ${isVertical ? 'img-col-vertical' : 'img-col-horizontal'}`}>
            <div class={`project-img-frame ${isVertical ? 'frame-vertical' : 'frame-horizontal'}`}>
              <img src={p.image} alt={p.name} class="project-img" loading="lazy" />
              <div class="img-shine"></div>
            </div>
          </div>

          {/* Columna contenido */}
          <div class="project-content-col">
            <div class="project-number">0{i + 1}</div>
            <h3 class="project-name">{p.name}</h3>
            <p class="project-desc">{p.description}</p>

            <div class="tech-list">
              {p.tech.map(t => <span class="tech-tag">{t}</span>)}
            </div>

            <div class="project-actions">
              {p.isPrivate ? (
                <span class="btn-private">
                  <span class="material-icons">lock</span> Privado
                </span>
              ) : (
                <>
                  {p.repoLink && (
                    <a href={p.repoLink} target="_blank" class="btn-action btn-outline">
                      <span class="material-icons">code</span> Código
                    </a>
                  )}
                  {p.demoLink && (
                    <a href={p.demoLink} target="_blank" class="btn-action btn-solid">
                      <span class="material-icons">play_circle</span> Demo
                    </a>
                  )}
                  {p.webLink && (
                    <a href={p.webLink} target="_blank" class="btn-action btn-ghost">
                      <span class="material-icons">language</span> Sitio
                    </a>
                  )}
                </>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
.projects-section {
  padding: 80px 20px;
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; gap: 60px;
}

.section-header { text-align: center; max-width: 600px; }
.section-label  { font-family: monospace; font-size: 0.85rem; color: var(--cyan, #2DD4BF); opacity: 0.7; margin-bottom: 8px; }
.section-title  { font-family: 'Syne', sans-serif; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; color: var(--text-primary); margin-bottom: 12px; }
.section-sub    { font-size: 1rem; color: var(--text-secondary); line-height: 1.6; }

.projects-list  { display: flex; flex-direction: column; gap: 48px; width: 100%; max-width: 1000px; }

/* ── CARD BASE ── */
.project-card {
  display: grid;
  gap: 36px;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 32px;
  position: relative; overflow: hidden;
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
}
.project-card::before {
  content: ''; position: absolute;
  top: -1px; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent, #2DD4BF), transparent);
  opacity: 0; transition: opacity 0.3s;
}
.project-card:hover {
  border-color: var(--border-hover);
  transform: translateY(-4px);
  box-shadow: var(--card-shadow-hover);
}
.project-card:hover::before { opacity: 1; }

/* ── LAYOUT HORIZONTAL (imagen ancha, lado a lado) ── */
.layout-horizontal {
  grid-template-columns: 1.1fr 1fr;
}
.layout-horizontal.reverse {
  grid-template-columns: 1fr 1.1fr;
  direction: rtl;
}
.layout-horizontal.reverse > * { direction: ltr; }

/* ── LAYOUT VERTICAL (imagen en formato retrato, columna más estrecha) ── */
.layout-vertical {
  grid-template-columns: 0.55fr 1fr;
}
.layout-vertical.reverse {
  grid-template-columns: 1fr 0.55fr;
  direction: rtl;
}
.layout-vertical.reverse > * { direction: ltr; }

/* ── FRAMES DE IMAGEN ── */
.project-img-frame {
  position: relative; border-radius: 12px; overflow: hidden;
  background: var(--bg-2);
}

/* Imagen horizontal: ratio 16:10 */
.frame-horizontal {
  aspect-ratio: 16 / 10;
}

/* Imagen vertical: ratio 9:16 (móvil) */
.frame-vertical {
  aspect-ratio: 9 / 16;
  max-height: 480px;
  /* centra el frame si la columna es más alta */
  margin: 0 auto;
  width: 100%;
}

.project-img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.5s;
}
.project-card:hover .project-img { transform: scale(1.04); }

.img-shine {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(45, 212, 191, 0.07) 0%, transparent 60%);
  pointer-events: none;
}

/* ── CONTENIDO ── */
.project-content-col { display: flex; flex-direction: column; gap: 16px; }

.project-number {
  font-family: 'Syne', sans-serif; font-size: 3rem;
  font-weight: 800; line-height: 1;
  color: var(--border);
}
.project-name {
  font-family: 'Syne', sans-serif; font-size: 1.25rem;
  font-weight: 700; color: var(--text-primary); line-height: 1.35;
}
.project-desc {
  font-size: 0.88rem; color: var(--text-secondary); line-height: 1.75;
}

.tech-list { display: flex; flex-wrap: wrap; gap: 8px; }
.tech-tag {
  font-size: 0.75rem; font-family: monospace;
  color: var(--accent); background: var(--pill-bg);
  padding: 4px 10px; border-radius: 6px;
  border: 1px solid var(--pill-border);
}

.project-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.btn-action {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 16px; border-radius: 8px;
  font-size: 0.85rem; font-weight: 500;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none; transition: all 0.25s;
}
.btn-outline {
  border: 1px solid var(--border-hover);
  color: var(--text-primary); background: transparent;
}
.btn-outline:hover {
  background: var(--btn-code-hover);
  color: var(--accent);
  border-color: var(--accent);
}
.btn-solid {
  background: var(--accent); color: var(--bg, #060D0D);
  border: none; font-weight: 600;
}
.btn-solid:hover { opacity: 0.85; transform: translateY(-1px); }
.btn-ghost {
  border: 1px solid var(--border);
  color: var(--text-secondary); background: transparent;
}
.btn-ghost:hover { border-color: var(--border-hover); color: var(--text-primary); }

.btn-private {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 16px; border-radius: 8px;
  font-size: 0.85rem; color: var(--text-muted);
  border: 1px dashed var(--border);
  background: transparent; opacity: 0.7;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .project-card,
  .layout-horizontal,
  .layout-horizontal.reverse,
  .layout-vertical,
  .layout-vertical.reverse {
    grid-template-columns: 1fr !important;
    direction: ltr !important;
    gap: 24px;
    padding: 24px;
  }

  /* En móvil: vertical se muestra más compacto */
  .frame-vertical {
    aspect-ratio: 4 / 5;
    max-height: 320px;
  }
  .frame-horizontal {
    aspect-ratio: 16 / 9;
  }

  .project-number { font-size: 2rem; }
}
</style>